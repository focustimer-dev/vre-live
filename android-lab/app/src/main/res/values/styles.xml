<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VRELiveLab" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/vre_electric_bg</item>
        <item name="android:navigationBarColor">@color/vre_electric_bg</item>
        <item name="android:colorAccent">@color/vre_electric_cobalt</item>
        <item name="android:windowBackground">@color/vre_electric_bg</item>
    </style>
    <style name="Theme.VRELiveLab.NordLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/vre_nord_bg</item>
        <item name="android:navigationBarColor">@color/vre_nord_bg</item>
        <item name="android:colorAccent">@color/vre_nord_accent</item>
        <item name="android:windowBackground">@color/vre_nord_bg</item>
    </style>
</resources>
